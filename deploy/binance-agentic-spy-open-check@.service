[Unit]
Description=One-time read-only SPY opening follow-up (%i)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=binancebot
Group=binancebot
WorkingDirectory=/opt/binance-agentic-spy-open-check/current
EnvironmentFile=/etc/binance-agentic-spy-open-check.env
Environment=HOME=/var/lib/binance-agentic-spy-open-check
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy NODE_OPTIONS BOT_LIVE BINANCE_INSTANCE_ID FUND_MANAGER_SEND FUND_MANAGER_PUBLISH FEISHU_WEBHOOK_URL
ExecStartPre=/usr/bin/node --max-old-space-size=128 /opt/binance-agentic-spy-open-check/current/run.mjs verify
ExecStart=/usr/bin/node --max-old-space-size=128 /opt/binance-agentic-spy-open-check/current/run.mjs %i
StateDirectory=binance-agentic-spy-open-check
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=240
CPUQuota=25%
MemoryHigh=192M
MemoryMax=256M
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectProc=invisible
ProcSubset=pid
ProtectSystem=strict
ReadOnlyPaths=/opt/binance-agentic-stock-bot /run
ReadWritePaths=/var/lib/binance-agentic-spy-open-check
InaccessiblePaths=/etc/binance-agentic-stock-bot.env /var/lib/binance-agentic-stock-bot /proc
RestrictNamespaces=true
SystemCallFilter=~ptrace process_vm_readv process_vm_writev pidfd_getfd kill tkill tgkill pidfd_send_signal rt_sigqueueinfo rt_tgsigqueueinfo
SystemCallErrorNumber=EPERM
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
