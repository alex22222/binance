[Unit]
Description=Read-only public capital market overview
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=binancebot
Group=binancebot
WorkingDirectory=/opt/binance-agentic-personal-assets/current
Environment=MARKET_OVERVIEW_DIR=/opt/binance-agentic-stock-bot/state/market-overview
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/usr/bin/node /opt/binance-agentic-personal-assets/current/scripts/run-market-overview.mjs
TimeoutStartSec=180
MemoryMax=192M
CPUQuota=20%
TasksMax=32
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/binance-agentic-stock-bot/state/market-overview
UMask=0077

