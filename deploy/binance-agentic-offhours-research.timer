[Unit]
Description=Four measured public snapshots per New York weekday (no backfill)

[Timer]
OnCalendar=Mon..Fri *-*-* 09:20:00 America/New_York
OnCalendar=Mon..Fri *-*-* 09:35:00 America/New_York
OnCalendar=Mon..Fri *-*-* 16:10:00 America/New_York
OnCalendar=Mon..Fri *-*-* 20:00:00 America/New_York
Persistent=false
AccuracySec=1s
Unit=binance-agentic-offhours-research.service

[Install]
WantedBy=timers.target
