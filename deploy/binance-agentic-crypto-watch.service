[Unit]
Description=Read-only OKX favorites daily market summary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=binancebot
Group=binancebot
WorkingDirectory=/opt/binance-agentic-personal-assets/current
Environment=CRYPTO_WATCH_DIR=/opt/binance-agentic-stock-bot/state/crypto
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/usr/bin/node /opt/binance-agentic-personal-assets/current/scripts/run-crypto-watch.mjs
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/binance-agentic-stock-bot/state/crypto
UMask=0077

