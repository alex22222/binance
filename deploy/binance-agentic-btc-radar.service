[Unit]
Description=Binance Agentic BTC risk radar evaluation
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=binancebot
Group=binancebot
WorkingDirectory=/opt/binance-agentic-stock-bot
EnvironmentFile=/etc/binance-agentic-stock-bot.env
EnvironmentFile=-/etc/binance-agentic-btc-radar.env
Environment=HOME=/var/lib/binance-agentic-stock-bot
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/usr/bin/node scripts/run-btc-radar.mjs
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/binance-agentic-stock-bot/state/btc-radar
UMask=0077
