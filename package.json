{
  "name": "binance-agentic-stock-bot",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node src/bot.mjs",
    "once": "node src/bot.mjs --once",
    "mock": "node src/bot.mjs --mock-trade",
    "dashboard": "node scripts/generate-strategy-dashboard.mjs",
    "dashboard:open": "npm run dashboard && open artifacts/strategy-mock-dashboard.html",
    "dashboard:live": "node scripts/serve-live-dashboard.mjs",
    "strategy:validate": "node scripts/run-strategy-validation.mjs",
    "strategy:shadow-outcomes": "node scripts/run-shadow-outcomes.mjs",
    "watch": "node watch/watcher.mjs",
    "test:watch-webbridge": "node watch/webbridge-smoke.mjs",
    "preflight:linux": "node scripts/preflight-linux.mjs",
    "emergency-stop": "node scripts/emergency-stop.mjs",
    "emergency-resume": "node scripts/emergency-resume.mjs --confirm",
    "patch:baw-session": "node scripts/patch-baw-session-persistence.mjs",
    "check:baw-session": "node scripts/patch-baw-session-persistence.mjs --check",
    "test:feishu": "node src/bot.mjs --test-feishu",
    "test": "node --test"
  }
}
