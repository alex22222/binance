# Optional OKX credentials for the BTC risk radar: contract DCA position and
# BTC news sentiment. Use a READ-ONLY API key bound to this server's IP.
# The radar only sends signed GET requests and never trades.
#
# Install without exposing the values in shell history:
#   sudo install -m 640 -o root -g binancebot /dev/null /etc/binance-agentic-btc-radar.env
#   sudoedit /etc/binance-agentic-btc-radar.env
OKX_API_KEY=replace-with-read-only-api-key
OKX_API_SECRET=replace-with-secret-key
OKX_API_PASSPHRASE=replace-with-passphrase

# Optional: pin one contract DCA bot. By default the radar follows the newest
# running BTC-USDT-SWAP long contract DCA bot.
BTC_RADAR_DCA_ALGO_ID=
