[Unit]
Description=Isolated ETF frequency and lookback Paper comparison
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=binancebot
Group=binancebot
WorkingDirectory=/opt/binance-agentic-stock-bot
UnsetEnvironment=HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
ExecStart=/usr/bin/flock -n -E 75 state/etf-frequency-paper/runner.lock /usr/bin/node --max-old-space-size=128 scripts/run-etf-frequency-paper.mjs
SuccessExitStatus=75
Nice=15
CPUQuota=25%
MemoryHigh=160M
MemoryMax=192M
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/binance-agentic-stock-bot/state/etf-frequency-paper
InaccessiblePaths=/etc/binance-agentic-stock-bot.env /var/lib/binance-agentic-stock-bot/.baw
UMask=0027

