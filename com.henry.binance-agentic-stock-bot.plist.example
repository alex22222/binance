<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.henry.binance-agentic-stock-bot</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/henry/projects/binance/scripts/run-from-keychain.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/henry/projects/binance</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BOT_LIVE</key>
    <string>0</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <dict>
    <key>SuccessfulExit</key>
    <false/>
  </dict>
  <key>ThrottleInterval</key>
  <integer>30</integer>
  <key>StandardOutPath</key>
  <string>/Users/henry/projects/binance/state/bot.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/henry/projects/binance/state/bot.err.log</string>
</dict>
</plist>
