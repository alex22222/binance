# Copy to /etc/binance-agentic-stock-bot.env and chmod 600.
# Do not commit the populated file.

BINANCE_INSTANCE_ID=replace-with-a-stable-random-uuid
BAW_CLI_PATH=/usr/local/bin/baw
NPM_CLI_PATH=/usr/bin/npm

FEISHU_APP_ID=replace-me
FEISHU_APP_SECRET=replace-me
FEISHU_RECEIVE_ID=replace-me
FEISHU_CHAT_ID=replace-me

DASHBOARD_USERNAME=replace-me
DASHBOARD_PASSWORD=replace-with-a-long-random-password
DASHBOARD_PUBLIC_ORIGIN=https://stocks.example.com
DASHBOARD_URL=http://127.0.0.1:4173

# Proxy variables are intentionally omitted and the systemd units explicitly
# unset inherited proxy variables. Add a unit override only if a future server
# explicitly needs a proxy.
