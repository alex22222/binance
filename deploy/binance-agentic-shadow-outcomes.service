[Unit]
Description=Binance Agentic Stock Shadow Outcome Report
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=binancebot
Group=binancebot
WorkingDirectory=/opt/binance-agentic-stock-bot
Environment=HOME=/var/lib/binance-agentic-stock-bot
ExecStart=/usr/bin/node scripts/run-shadow-outcomes.mjs
Nice=10
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/binance-agentic-stock-bot/state
UMask=0077
