[Unit]
Description=Daily strategy evidence journal and tracking scores (no trading)
After=binance-agentic-strategy-evidence.service

[Service]
Type=oneshot
User=binancebot
Group=binancebot
WorkingDirectory=/opt/binance-agentic-stock-bot
ExecStart=/usr/bin/flock -n -E 75 state/strategy-daily/runner.lock /usr/bin/node --max-old-space-size=128 scripts/record-strategy-daily.mjs
SuccessExitStatus=75
Nice=15
CPUQuota=25%
MemoryMax=192M
TimeoutStartSec=240
NoNewPrivileges=true
PrivateTmp=true
PrivateNetwork=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/binance-agentic-stock-bot/state/strategy-daily
InaccessiblePaths=/etc/binance-agentic-stock-bot.env /var/lib/binance-agentic-stock-bot/.baw
UMask=0027
